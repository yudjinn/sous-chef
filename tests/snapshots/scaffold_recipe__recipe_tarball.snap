--- create meta-mine:recipes-app/gizmo/gizmo_2.0.bb
SUMMARY = "Gizmo tool"
HOMEPAGE = "https://example.org/gizmo"
LICENSE = "GPL-2.0-only"
LIC_FILES_CHKSUM = "file://COPYING;md5=b234ee4d69f5fce4486a80fdaf4a4263"

DEPENDS = "zlib openssl"

SRC_URI = "https://example.org/releases/${BP}.tar.gz"
SRC_URI[sha256sum] = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

inherit autotools

RDEPENDS:${PN} += "bash"
note: the default S assumes the tarball unpacks into gizmo-2.0/; set S otherwise
note: class autotools was not found in the indexed layers; it is the OE-core name, so the layer needs OE-core (or the layer that provides it) in BBLAYERS
