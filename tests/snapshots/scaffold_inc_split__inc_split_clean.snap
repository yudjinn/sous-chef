---
source: tests/scaffold_inc_split.rs
expression: text
---
--- create meta-mine:recipes-app/greet/greet.inc
SUMMARY = "Greeting tool"
DESCRIPTION = "Prints a friendly greeting."
HOMEPAGE = "https://example.org/greet"
SECTION = "examples"
LICENSE = "MIT"

DEPENDS = "virtual/foo"

SRC_URI = "https://example.org/releases/greet-${PV}.tar.gz"

inherit autotoolsish

# Native language support is not wanted on the target.
EXTRA_OECONF = "--disable-nls"

do_install:append() {
	install -d ${D}${sysconfdir}

	echo "greeting=hello" > ${D}${sysconfdir}/greet.conf
}

FILES:${PN} += "${sysconfdir}/greet.conf"
--- modify meta-mine:recipes-app/greet/greet_1.1.bb
# Copyright example.org
# SPDX-License-Identifier: MIT

require greet.inc

LIC_FILES_CHKSUM = "file://COPYING;md5=0835ade698e0bcf8506ecda2f7b4f302"

SRC_URI += "file://fix-greeting.patch"
SRC_URI[sha256sum] = "2222222222222222222222222222222222222222222222222222222222222222"

PACKAGECONFIG ??= "greeting"
PACKAGECONFIG[greeting] = "--enable-greeting,--disable-greeting"
--- modify meta-mine:recipes-app/greet/greet_1.0.bb
# Copyright example.org
# SPDX-License-Identifier: MIT

require greet.inc

LIC_FILES_CHKSUM = "file://COPYING;md5=0835ade698e0bcf8506ecda2f7b4f302"

SRC_URI[sha256sum] = "1111111111111111111111111111111111111111111111111111111111111111"
note: 11 statements shared by greet_1.1.bb and greet_1.0.bb move into meta-mine:recipes-app/greet/greet.inc; each version requires it
note: greet_1.1.bb keeps LIC_FILES_CHKSUM, SRC_URI, SRC_URI[sha256sum], PACKAGECONFIG and PACKAGECONFIG[greeting]
note: greet_1.0.bb keeps LIC_FILES_CHKSUM and SRC_URI[sha256sum]
