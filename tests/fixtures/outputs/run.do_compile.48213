#!/bin/sh

__BITBAKE_LAST_LINE=0

# Emit a useful diagnostic if something fails:
bb_sh_exit_handler() {
    ret=$?
    if [ "$ret" != 0 ]; then
        echo "WARNING: exit code $ret from a shell command."
    fi
    exit $ret
}

bb_bash_exit_handler() {
    ret=$?
    { set +x; } > /dev/null
    trap "" DEBUG
    if [ "$ret" != 0 ]; then
        echo "WARNING: ${BASH_SOURCE[0]}:${__BITBAKE_LAST_LINE} exit $ret from '$1'"

        echo "WARNING: Backtrace (BB generated script): "
        for i in $(seq 1 $((${#FUNCNAME[@]} - 1))); do
            if [ "$i" -eq 1 ]; then
                echo -e "\t#$((i)): ${FUNCNAME[$i]}, ${BASH_SOURCE[$((i-1))]}, line ${__BITBAKE_LAST_LINE}"
            else
                echo -e "\t#$((i)): ${FUNCNAME[$i]}, ${BASH_SOURCE[$((i-1))]}, line ${BASH_LINENO[$((i-1))]}"
            fi
        done
    fi
    exit $ret
}

bb_bash_debug_handler() {
    local line=${BASH_LINENO[0]}
    # For some reason the DEBUG trap trips with lineno=1 when scripts exit; ignore it
    if [ "$line" -eq 1 ]; then
        return
    fi

    # Track the line number of commands as they execute. This is so we can have access to the failing line number
    # in the EXIT trap. See http://gnu-bash.2382.n7.nabble.com/trap-echo-quot-trap-exit-on-LINENO-quot-EXIT-gt-wrong-linenumber-td3666.html
    if [ "${FUNCNAME[1]}" != "bb_bash_exit_handler" ]; then
        __BITBAKE_LAST_LINE=$line
    fi
}

case $BASH_VERSION in
"") trap 'bb_sh_exit_handler' 0
    set -e
    ;;
*)  trap 'bb_bash_exit_handler "$BASH_COMMAND"' 0
    trap '{ bb_bash_debug_handler; } 2>/dev/null' DEBUG
    set -e
    shopt -s extdebug
    ;;
esac
export AR="x86_64-poky-linux-gcc-ar"
export BUILD_CC="gcc "
export CC="x86_64-poky-linux-gcc  -m64 -march=core2 -mtune=core2 -msse3 -mfpmath=sse -fstack-protector-strong  -O2 -D_FORTIFY_SOURCE=2 -Wformat -Wformat-security -Werror=format-security --sysroot=/home/builder/poky/build/tmp/work/core2-64-poky-linux/hello/1.0/recipe-sysroot"
export CFLAGS=" -O2 -pipe -g -feliminate-unused-debug-types "
export HOME="/home/builder"
export LOGFIFO="/home/builder/poky/build/tmp/work/core2-64-poky-linux/hello/1.0/temp/fifo.48213"
export MAKE="make"
export PATH="/home/builder/poky/build/tmp/work/core2-64-poky-linux/hello/1.0/recipe-sysroot-native/usr/bin:/home/builder/poky/scripts:/usr/bin:/bin"
export PKG_CONFIG_SYSROOT_DIR="/home/builder/poky/build/tmp/work/core2-64-poky-linux/hello/1.0/recipe-sysroot"
export TARGET_PREFIX="x86_64-poky-linux-"
EXTRA_OEMAKE="-j 8"
PN="hello"
PV="1.0"

# line: 41, file: /home/builder/poky/meta-core/classes/base.bbclass
do_compile() {
	autotoolsish_do_compile
}

# line: 22, file: /home/builder/poky/meta-core/classes-recipe/autotoolsish.bbclass
autotoolsish_do_compile() {
	oe_runmake
}

# line: 82, file: /home/builder/poky/meta/classes-global/logging.bbclass
bbfatal_log() {
	if [ -p ${LOGFIFO} ] ; then
		printf "%b\0" "bbfatal_log $*" > ${LOGFIFO}
	else
		echo "ERROR: $*"
	fi
	exit 1
}

# line: 38, file: /home/builder/poky/meta/classes-global/base.bbclass
die() {
	bbfatal_log "$*"
}

# line: 47, file: /home/builder/poky/meta/classes-global/base.bbclass
oe_runmake() {
	oe_runmake_call "$@" || die "oe_runmake failed"
}

# line: 42, file: /home/builder/poky/meta/classes-global/base.bbclass
oe_runmake_call() {
	bbnote ${MAKE} ${EXTRA_OEMAKE} "$@"
	${MAKE} ${EXTRA_OEMAKE} "$@"
}

# line: 100, file: /home/builder/poky/meta/classes-global/logging.bbclass
bbnote() {
	if [ -p ${LOGFIFO} ] ; then
		printf "%b\0" "bbnote $*" > ${LOGFIFO}
	else
		echo "NOTE: $*"
	fi
}

cd '/home/builder/poky/build/tmp/work/core2-64-poky-linux/hello/1.0/build'
do_compile

# cleanup
ret=$?
trap '' 0
exit $ret
