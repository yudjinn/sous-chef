# line: 149, file: {{LIVE}}/yocto-kiss/build/../openembedded-core/meta/classes-recipe/autotools.bbclass
autotools_do_configure() {
	# WARNING: gross hack follows:
	# An autotools built package generally needs these scripts, however only
	# automake or libtoolize actually install the current versions of them.
	# This is a problem in builds that do not use libtool or automake, in the case
	# where we -need- the latest version of these scripts.  e.g. running a build
	# for a package whose autotools are old, on an x86_64 machine, which the old
	# config.sub does not support.  Work around this by installing them manually
	# regardless.

	PRUNE_M4=""

	for ac in `find {{LIVE}}/yocto-kiss/build/tmp/work/armv7at2hf-neon-oe-linux-gnueabi/curl/8.19.0/sources/curl-8.19.0 -ignore_readdir_race -name configure.in -o -name configure.ac`; do
		rm -f `dirname $ac`/configure
	done
	if [ -e {{LIVE}}/yocto-kiss/build/tmp/work/armv7at2hf-neon-oe-linux-gnueabi/curl/8.19.0/sources/curl-8.19.0/configure.in -o -e {{LIVE}}/yocto-kiss/build/tmp/work/armv7at2hf-neon-oe-linux-gnueabi/curl/8.19.0/sources/curl-8.19.0/configure.ac ]; then
		olddir=`pwd`
		cd {{LIVE}}/yocto-kiss/build/tmp/work/armv7at2hf-neon-oe-linux-gnueabi/curl/8.19.0/sources/curl-8.19.0
		# aclocal looks in the native sysroot by default, so tell it to also look in the target sysroot.
		ACLOCAL="aclocal --aclocal-path={{LIVE}}/yocto-kiss/build/tmp/work/armv7at2hf-neon-oe-linux-gnueabi/curl/8.19.0/recipe-sysroot/usr/share/aclocal/"
		if [ -e configure.in ]; then
			CONFIGURE_AC=configure.in
		else
			CONFIGURE_AC=configure.ac
		fi
		if grep -q "^[[:space:]]*AM_GLIB_GNU_GETTEXT" $CONFIGURE_AC; then
			if grep -q "sed.*POTFILES" $CONFIGURE_AC; then
				: do nothing -- we still have an old unmodified configure.ac
	    		else
				bbnote Executing glib-gettextize --force --copy
				echo "no" | glib-gettextize --force --copy
			fi
		elif [ "curl" != "gettext" ] && grep -q "^[[:space:]]*AM_GNU_GETTEXT" $CONFIGURE_AC; then
			# Gettextize could be called here, however it doesn't make the job much easier:
			# It doesn't discover relevant po folders on its own, so they still need to be
			# found by some heurestics. Also, it would require always the full gettext
			# package always, instead of gettext-minimal-native.
			cp {{LIVE}}/yocto-kiss/build/tmp/work/armv7at2hf-neon-oe-linux-gnueabi/curl/8.19.0/recipe-sysroot-native/usr/share/gettext/config.rpath {{LIVE}}/yocto-kiss/build/tmp/work/armv7at2hf-neon-oe-linux-gnueabi/curl/8.19.0/sources/curl-8.19.0/
			if [ -d {{LIVE}}/yocto-kiss/build/tmp/work/armv7at2hf-neon-oe-linux-gnueabi/curl/8.19.0/sources/curl-8.19.0/po ]; then
				# Copy the latest Makefile.in.in to the /po folder, regardless if it exists or not
				# If it exists, then also look for identical Makefile.in.in files, and update them too
				makefiles_to_update="./po/Makefile.in.in"
				if [ -f {{LIVE}}/yocto-kiss/build/tmp/work/armv7at2hf-neon-oe-linux-gnueabi/curl/8.19.0/sources/curl-8.19.0/po/Makefile.in.in ]; then
					# search for all Makefile.in.in files that are identical to ./po/Makefile.in.in, by md5sum
					base_makefile_hash=`md5sum {{LIVE}}/yocto-kiss/build/tmp/work/armv7at2hf-neon-oe-linux-gnueabi/curl/8.19.0/sources/curl-8.19.0/po/Makefile.in.in | tr -s ' ' | cut -f1 -d' '`
					makefiles_to_update=`find {{LIVE}}/yocto-kiss/build/tmp/work/armv7at2hf-neon-oe-linux-gnueabi/curl/8.19.0/sources/curl-8.19.0 -name Makefile.in.in -exec md5sum {} \+ | grep $base_makefile_hash | tr -s ' ' | cut -d' ' -f2`
				fi
				bbnote List of Makefile.in.ins to update: $makefiles_to_update
				for makefile in ${makefiles_to_update}; do
					makefile_dir=$(dirname $makefile)
					bbnote Executing: cp {{LIVE}}/yocto-kiss/build/tmp/work/armv7at2hf-neon-oe-linux-gnueabi/curl/8.19.0/recipe-sysroot-native/usr/share/gettext/po/Makefile.in.in ${makefile_dir}/
					cp {{LIVE}}/yocto-kiss/build/tmp/work/armv7at2hf-neon-oe-linux-gnueabi/curl/8.19.0/recipe-sysroot-native/usr/share/gettext/po/Makefile.in.in ${makefile_dir}/
					if [ ! -e ${makefile_dir}/remove-potcdate.sed ]; then
						cp {{LIVE}}/yocto-kiss/build/tmp/work/armv7at2hf-neon-oe-linux-gnueabi/curl/8.19.0/recipe-sysroot-native/usr/share/gettext/po/remove-potcdate.sed ${makefile_dir}/
					fi
				done
				for makevars in `find {{LIVE}}/yocto-kiss/build/tmp/work/armv7at2hf-neon-oe-linux-gnueabi/curl/8.19.0/sources/curl-8.19.0 -name Makevars`; do
					bbnote Concatenating Makevars: $makevars
					cat {{LIVE}}/yocto-kiss/build/tmp/work/armv7at2hf-neon-oe-linux-gnueabi/curl/8.19.0/recipe-sysroot-native/usr/share/gettext/po/Makevars.template.minimal ${makevars} >> ${makevars}.yocto_temp
					mv ${makevars}.yocto_temp ${makevars}
				done
			fi
			PRUNE_M4="$PRUNE_M4 gettext.m4 iconv.m4 lib-ld.m4 lib-link.m4 lib-prefix.m4 nls.m4 po.m4 progtest.m4"
		fi
		mkdir -p m4

		for i in $PRUNE_M4; do
			find {{LIVE}}/yocto-kiss/build/tmp/work/armv7at2hf-neon-oe-linux-gnueabi/curl/8.19.0/sources/curl-8.19.0 -ignore_readdir_race -name $i -delete
		done

		bbnote Executing ACLOCAL=\"$ACLOCAL\" autoreconf -Wcross --verbose --install --force  --exclude=autopoint
		ACLOCAL="$ACLOCAL" autoreconf -Wcross -Wno-obsolete --verbose --install --force  --exclude=autopoint || die "autoreconf execution failed."
		cd $olddir
	fi

	oe_runconf
}

# line: 27, file: {{LIVE}}/yocto-kiss/build/../openembedded-core/meta/classes-global/logging.bbclass
bbnote() {
	if [ -p {{LIVE}}/yocto-kiss/build/tmp/work/armv7at2hf-neon-oe-linux-gnueabi/curl/8.19.0/temp/fifo.1749535 ] ; then
