#!/usr/bin/env bash
# Fake bitbake (bitbake-layers, bitbake-getvar, devtool and oe-pkgdata-util link here) for
# tests. Prints what it was given, then behaves as the environment says:
#   FAKEBB_OUTPUT       file printed to stdout (recorded real output)
#   FAKEBB_STDERR       text printed to stderr
#   FAKEBB_SLEEP        seconds to sleep in a child process before exiting
#   FAKEBB_PIDFILE      file that receives "<own pid> <sleep pid>" once sleeping
#   FAKEBB_IGNORE_TERM  1: ignore SIGTERM (it, and the sleep child, then need SIGKILL)
#   FAKEBB_EXIT         exit status (default 0)
echo "fakebb: $(basename "$0")"
echo "cwd: $PWD"
echo "BUILDDIR: ${BUILDDIR-}"
echo "argc: $#"
for a in "$@"; do
    printf 'arg: %s\n' "$a"
done
if [ -n "${FAKEBB_OUTPUT-}" ]; then
    cat "$FAKEBB_OUTPUT"
fi
if [ -n "${FAKEBB_STDERR-}" ]; then
    printf '%s\n' "$FAKEBB_STDERR" >&2
fi
if [ -n "${FAKEBB_SLEEP-}" ]; then
    if [ "${FAKEBB_IGNORE_TERM-}" = 1 ]; then
        trap '' TERM
    fi
    sleep "$FAKEBB_SLEEP" &
    child=$!
    if [ -n "${FAKEBB_PIDFILE-}" ]; then
        echo "$$ $child" > "$FAKEBB_PIDFILE.tmp" && mv "$FAKEBB_PIDFILE.tmp" "$FAKEBB_PIDFILE"
    fi
    wait "$child"
fi
exit "${FAKEBB_EXIT-0}"
