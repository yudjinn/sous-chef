#!/usr/bin/env bash
# Fake kas for tests (never the real kas). It prints its argv, appends one line per call to
# ./fakekas-called (its working directory, kas's work directory) so a test can tell whether
# kas was started at all, sources ./fakekas.env when it exists (`export FAKEBB_...` lines
# for the fake BitBake, as init-with-env does), and for
# `kas shell [options] <files> -c <command>` does what kas does with the command: runs it as
# one string under a shell (here always /bin/sh, so tests do not depend on the user's
# $SHELL), in the build directory ($KAS_BUILD_DIR, else ./build), with BUILDDIR and BBPATH
# set and the fake BitBake (../bin) first on PATH. With FAKEKAS_AS_KAS=1 it stays the
# parent, as kas 5.5 does (`ShellCommand.execute`: `subprocess.call([$SHELL, "-c", cmd])`),
# and handles SIGINT and SIGTERM as kas does: kas.py registers them on its asyncio loop,
# whose handler only queues the callback, and the loop does not run while subprocess.call
# waits, so kas goes on waiting for the shell; the signal reaches the command through the
# process group. It prints the exit status of the command and exits with it.
FAKEBB_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
printf '%s\n' "$*" >> "$PWD/fakekas-called"
if [ -f "$PWD/fakekas.env" ]; then
    . "$PWD/fakekas.env"
fi
echo "fakekas: argc $#"
for a in "$@"; do
    printf 'kasarg: %s\n' "$a"
done
[ "${1-}" = shell ] || exit 0
shift
cmd=""
while [ $# -gt 0 ]; do
    case "$1" in
    -c | --command)
        cmd="$2"
        shift 2
        ;;
    *)
        shift
        ;;
    esac
done
BUILDDIR="${KAS_BUILD_DIR:-$PWD/build}"
export BUILDDIR
export BBPATH="$BUILDDIR"
export PATH="$FAKEBB_ROOT/bin:$PATH"
cd "$BUILDDIR" || exit 1
if [ "${FAKEKAS_AS_KAS-}" = 1 ]; then
    trap 'echo "fakekas: SIGINT handled later"' INT
    trap 'echo "fakekas: SIGTERM handled later"' TERM
    /bin/sh -c "$cmd"
    st=$?
    echo "fakekas: shell returned $st"
    exit "$st"
fi
exec /bin/sh -c "$cmd"
