{
 "base-k-plain": {
  "DEPENDS": "base1 lib32-depa lib32-depc lib32-dep2",
  "PACKAGECONFIG_CONFARGS": "--x --en-a --dis-b Documentation",
  "RDEPENDS:amb5": "r0 lib32-rdepa",
  "RRECOMMENDS:amb5": " rreca rrecc"
 },
 "base-s-mlprefix": {
  "DEPENDS": "base1 lib32-depa virtual/lib32-libx lib32-q zlib-native gcc-cross-arm",
  "PACKAGECONFIG_CONFARGS": " --en-a",
  "RDEPENDS:amb4": " lib32-rdepa",
  "RRECOMMENDS:amb4": " rreca rrecc"
 },
 "base-w-mlprefix": {
  "DEPENDS": "base1 lib32-depa virtual/lib32-libx lib32-q zlib-native gcc-cross-arm",
  "PACKAGECONFIG_CONFARGS": " --en-a",
