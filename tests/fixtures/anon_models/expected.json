  "PACKAGECONFIG_CONFARGS": "--x --en-a --dis-b Documentation --dis-e",
  "RDEPENDS:amb1": "r0 rdepa",
  "RRECOMMENDS:amb1": " rreca rrecc"
 },
 "cmake-make": {
  "DEPENDS": "d0",
  "OECMAKE_GENERATOR_ARGS": "-G 'Unix Makefiles' -DCMAKE_MAKE_PROGRAM=gmake",
  "do_compile[progress]": "percent"
 },
 "cmake-ninja": {
  "DEPENDS": "d0 ninja-native",
  "OECMAKE_GENERATOR_ARGS": "-G 'Ninja' -DCMAKE_MAKE_PROGRAM=ninja",
  "do_compile[progress]": "outof:^\\[(\\d+)/(\\d+)\\]\\s+"
 },
 "devicetree": {
